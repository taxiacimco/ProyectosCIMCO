// Versión Arquitectura: V2.0 - Endurecimiento Perimetral y Gobernanza Estrificada
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 🛡️ FUNCIONES DE GOBERNANZA Y AUTENTICACIÓN
    // ==========================================
    
    function usuarioAutenticado() {
      return request.auth != null;
    }

    function esPropietario(userId) {
      return usuarioAutenticado() && request.auth.uid == userId;
    }

    function esAdmin() {
      return usuarioAutenticado() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.rol == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin')) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'))
      );
    }

    // ==========================================
    // 🚀 REGLAS DE ACCESO PARA COLECCIONES CORE
    // ==========================================

    // 👥 COLECCIÓN DE USUARIOS / OPERADORES
    match /users/{userId} {
      allow read: if usuarioAutenticado();
      allow write: if esPropietario(userId) || esAdmin();
      match /{document=**} { 
        allow read: if usuarioAutenticado();
        allow write: if esPropietario(userId) || esAdmin();
      }
    }

    match /usuarios/{userId} {
      allow read: if usuarioAutenticado();
      allow write: if esPropietario(userId) || esAdmin();
      match /{document=**} { 
        allow read: if usuarioAutenticado();
        allow write: if esPropietario(userId) || esAdmin();
      }
    }

    // 🛵 NODO DE CONFIGURACIÓN Y VIAJES DE ARTIFACTS
    match /artifacts/taxiacimco-app/public/data/{collection}/{document=**} {
      allow read: if usuarioAutenticado();
      allow write: if esAdmin();
    }

    // 💰 BILLETERAS Y FINANZAS
    match /wallets/{walletId} { 
      allow read: if esPropietario(walletId) || esAdmin();
      allow write: if esAdmin();
    }
    
    match /historial_saldo/{id} { 
      allow read: if usuarioAutenticado() && (resource.data.targetUid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    match /transacciones/{transaccionId} {
      allow read: if usuarioAutenticado() && (resource.data.targetUid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // ==========================================================
    // 🔥 ENTORNO DE SIMULACIÓN, VIAJES Y TELEMETRÍA
    // ==========================================================
    
    match /viajes/{viajeId} {
      allow read, write: if usuarioAutenticado();
    }

    match /viajes/{document=**} {
      allow read, write: if usuarioAutenticado();
    }

    match /viajes_intermunicipales/{viajeId} {
      allow read, write: if usuarioAutenticado();
    }

    // Radar dinámico de conductores activos y telemetría
    match /conductores_activos/{document=**} {
      allow read, write: if usuarioAutenticado();
    }

    match /conductores/{document=**} {
      allow read, write: if usuarioAutenticado();
    }
  }
}