# Versión Arquitectura: V16.1.0 - Entorno Desarrollo Híbrido (Cloudflare / LAN)
# Ubicación: C:\Users\Carlos Fuentes\ProyectosCIMCO\frontend\.env.development

# 🌐 BASE URL Y ENLACE SEGURO TÚNEL HTTPS CLOUDFLARE
VITE_APP_BASE_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com
VITE_FRONTEND_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com
VITE_HOST_IP=192.168.100.34

# 🚀 CONEXIÓN DINÁMICA DE SOCKET Y API AL TÚNEL
# Al asignar el dominio del túnel en VITE_SOCKET_URL, el navegador usará wss:// automáticamente.
VITE_BACKEND_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com
VITE_API_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com/api
VITE_SOCKET_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com
VITE_API_FUNCTIONS_URL=https://observe-unwrap-powerseller-dialog.trycloudflare.com/api

# 🛡️ ACTIVACIÓN Y PUERTOS EXACTOS DE EMULADORES LOCALES
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=192.168.100.34
VITE_FIREBASE_EMULATOR_PORT=8085

# 📂 MAPEO EXPLÍCITO DE COLECCIONES FIRESTORE
VITE_FIRESTORE_PATH_USUARIOS=usuarios
VITE_FIRESTORE_PATH_CONDUCTORES=conductores
VITE_FIRESTORE_PATH_VIAJES=viajes